# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://clipforge:clipforge_dev_password@localhost:5432/clipforge"

# ─── Supabase (Auth + Storage) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-only, never expose to client

# ─── Site ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"        # used in Stripe redirect URLs

# ─── Backend API ────────────────────────────────────────────────
API_BASE_URL="http://localhost:8000"
API_SECRET_KEY="generate-a-long-random-string-here"  # shared secret between Next.js and FastAPI

# ─── Stripe (Phase 8) ────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_BUSINESS=""

# ─── AI Generation (Phase 6 - images/video) ─────────────────────
REPLICATE_API_TOKEN=""

# ─── AI Assistant (Phase 7) ──────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Rate limiting (Phase 10) ────────────────────────────────────
# Free tier at upstash.com — without these set, AI rate limiting is
# disabled (fails open) rather than blocking all requests.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── FastAPI settings (read from this same root .env) ───────────
WHISPER_MODEL_SIZE="small"       # small|medium|large-v3
WHISPER_DEVICE="cpu"             # cpu|cuda
WHISPER_COMPUTE_TYPE="int8"      # int8 (cpu) | float16 (gpu)
